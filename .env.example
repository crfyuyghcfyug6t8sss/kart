# Card issuing API (values come from the merchant dashboard). Never commit real values.
CARDS_API_BASE_URL=https://api.testsystemonly.com/openapi/
CARDS_APP_ID=
# PKCS8 RSA private key, Base64 (no PEM header)
CARDS_RSA_PRIVATE_KEY=
# "api aesKey" - used to encrypt/decrypt physical card PINs
CARDS_API_AES_KEY=
# "notify aesKey" - used to verify webhook signatures
CARDS_WEBHOOK_KEY=

# Comma-separated emails that can open /admin
ADMIN_EMAILS=
# Path of the SQLite database file
DATABASE_PATH=./data/kart.db
